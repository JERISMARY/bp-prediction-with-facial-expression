{
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": [
                "venv",
                ".venv",
                "**/*.pyc"
            ],
            "runtime": "python311"
        }
    ],
    "hosting": {
        "public": "static",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "**",
                "function": "pulse_guard_ai"
            }
        ]
    }
}